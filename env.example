# Database
DATABASE_URL=postgresql://user:password@host:5432/yaz_sports_bets

# Weather API (for NFL/MLB)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Scraping Config
SCRAPE_INTERVAL_HOURS=1
SCRAPE_MAX_RETRIES=3
SCRAPE_TIMEOUT_MS=10000

# Sportsbook API Keys (if available)
DRAFTKINGS_API_KEY=optional
FANDUEL_API_KEY=optional
BOVADA_API_KEY=optional
